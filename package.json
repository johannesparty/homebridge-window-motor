{
  "name": "homebridge-window-motor",
  "displayName": "Homebridge Window Motor",
  "icon": "https://raw.githubusercontent.com/johannesparty/homebridge-window-motor/main/branding/icon.png",
  "type": "module",
  "version": "0.7.7-beta.0",
  "private": false,
  "description": "Homebridge plugin for ESP32-based DIY window opener motors running custom ESPHome firmware.",
  "author": "Johannes Schmidt",
  "license": "ISC",
  "homepage": "https://github.com/johannesparty/homebridge-window-motor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannesparty/homebridge-window-motor.git"
  },
  "bugs": {
    "url": "https://github.com/johannesparty/homebridge-window-motor/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "window-motor",
    "esphome",
    "homebridge-window-motor"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "prebuild": "npm run clean && npm run build-ui",
    "build": "tsc",
    "build-ui": "shx mkdir -p homebridge-ui/public/lib && shx cp \"node_modules/homebridge-plugin-utils/dist/ui/**/*.@(js|mjs){,.map}\" homebridge-ui/public/lib",
    "clean": "shx rm -rf dist homebridge-ui/public/lib",
    "prelint": "npm run build-ui",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"-1\"} eslint.config.js src homebridge-ui/*.js homebridge-ui/public/**.mjs",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.1.0",
    "bonjour-service": "1.3.0",
    "eventsource": "4.0.0",
    "homebridge-plugin-utils": "1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/eventsource": "^1.1.15",
    "@types/node": "24.0.1",
    "eslint": "9.29.0",
    "homebridge": "1.10.0",
    "nodemon": "^3.1.9",
    "shx": "0.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0"
  },
  "homebridge": {
    "platforms": [
      {
        "platform": "WindowMotorPlugin",
        "name": "Window Motor Plugin"
      }
    ]
  }
}
