{
  "name": "homebridge-window-motor",
  "displayName": "Window Motor Plugin using ESPHome",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A short description about what your plugin does.",
  "author": "Johannes Schmidt",
  "license": "TBD",
  "homepage": "https://github.com/USERNAME/GITHUB_PROJECT_NAME#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/GITHUB_PROJECT_NAME.git"
  },
  "bugs": {
    "url": "https://github.com/USERNAME/GITHUB_PROJECT_NAME/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "window-motor",
    "esphome",
    "homebridge-window-motor"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "prebuild": "npm run clean && npm run build-ui",
    "build": "tsc",
    "build-ui": "shx mkdir -p homebridge-ui/public/lib && shx cp \"node_modules/homebridge-plugin-utils/dist/ui/**/*.@(js|mjs){,.map}\" homebridge-ui/public/lib",
    "clean": "shx rm -rf dist homebridge-ui/public/lib",
    "prelint": "npm run build-ui",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"-1\"} eslint.config.mjs src homebridge-ui/*.js homebridge-ui/public/**.mjs",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.1.0",
    "bonjour-service": "^1.3.0",
    "eventsource": "^4.0.0",
    "homebridge-plugin-utils": "^1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "shx": "^0.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "homebridge": {
    "platforms": [
      {
        "platform": "WindowMotorPlugin",
        "name": "Window Motor Plugin"
      }
    ]
  }
}
